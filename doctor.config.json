{
  "ignore": {
    "files": [".cache/**", "public/**"],
    "overrides": [
      {
        "files": [
          "src/pages/metadata.js",
          "src/pages/embed/index.js",
          "src/pages/link-preview.js"
        ],
        "rules": ["react-doctor/effect-needs-cleanup"]
      },
      {
        "files": [
          "src/html.js",
          "src/components/markdown/**",
          "src/components/elements/Annotation.js",
          "src/components/icons/Signature.js",
          "src/components/pages/blog/webgl-without-a-gpu/**",
          "src/components/hook/healthcheck-fragment.js",
          "src/components/hook/oss-fragment.js"
        ],
        "rules": ["deslop/unused-file"]
      },
      {
        "files": ["src/helpers/skills.js"],
        "rules": ["deslop/unused-export"]
      },
      {
        "files": ["package.json"],
        "rules": ["deslop/unused-dependency"]
      },
      {
        "files": [
          "src/html.js",
          "src/components/pages/builder/Builder.js",
          "src/components/pages/builder/generators.js",
          "src/components/pages/embed-url/EmbedTool.js",
          "src/components/pages/embed/InteractiveExample.js",
          "src/components/pages/home/hero.js"
        ],
        "rules": ["react-doctor/dangerous-html-sink"]
      },
      {
        "files": ["src/helpers/get-api-url.js"],
        "rules": ["react-doctor/insecure-crypto-risk"]
      },
      {
        "files": ["gatsby-ssr.js"],
        "rules": ["react-doctor/unsafe-json-in-html"]
      },
      {
        "files": [
          "src/pages/screenshot.js",
          "src/components/pages/screenshot/lang/ScreenshotDemo.js"
        ],
        "rules": ["react-doctor/no-unknown-property"]
      }
    ]
  }
}
