    {
      "source": "/",
      "destination": "/index.md",
      "permanent": false,
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ]
    },
    {
      "source": "/((?!tools/embed-url/|(?:recipes|404|dev-404-page|offline-plugin-app-shell-fallback)(?:/|$)|.*\\.[a-zA-Z0-9]+$).+)",
      "destination": "/$1.md",
      "permanent": false,
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.+)\\.md",
      "dest": "/404.md",
      "status": 404,
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, Accept-Encoding",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "src": "/(.*)",
      "missing": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "dest": "/404.md",
      "status": 404,
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, Accept-Encoding",
        "X-Robots-Tag": "noindex"
      }
    }
